# Native messaging manifests (generated by install.sh)
native-host/com.centrifugue.stemextractor.json
native-host/com.centrifugue.stemextractor.chrome.json

# Model cache (downloaded on first run)
.cache/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Built extension packages (produced by build-xpi.sh)
dist/
